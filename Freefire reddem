const express = require("express");
const crypto = require("crypto");

const app = express();
app.disable("x-powered-by");

// Configuration
const PORT = Number(process.env.PORT) || 3000;
const MERCHANT_SECRET = process.env.MERCHANT_SECRET || "demo_secret_change_me";
const BODY_LIMIT = "8kb";

// Demo products
const PRODUCTS = {
  10: { price: 10, coins: 100 },
  50: { price: 50, coins: 500 }
};

// Demo one-time codes (server will pop codes as they are issued)
const codes = [
  "FF-DEMO-1001",
  "FF-DEMO-1002",
  "FF-DEMO-1003"
];

// In-memory orders store for demo: Map<orderId, orderObject>
const ORDERS = new Map();

// Simple in-memory rate limiter (demo only)
const RATE_LIMIT_WINDOW_MS = 60 * 1000; // 1 minute
const RATE_LIMIT_MAX = 20; // max requests per IP per window
const ipRequests = new Map();

function isRateLimited(ip) {
  const now = Date.now();
  const entry = ipRequests.get(ip) || [];
  const windowStart = now - RATE_LIMIT_WINDOW_MS;
  const filtered = entry.filter(ts => ts > windowStart);
  filtered.push(now);
  ipRequests.set(ip, filtered);
  return filtered.length > RATE_LIMIT_MAX;
}

// Very small logger
app.use((req, res, next) => {
  console.log(`${new Date().toISOString()} ${req.ip} ${req.method} ${req.url}`);
  next();
});

// Basic rate limit middleware
app.use((req, res, next) => {
  if (isRateLimited(req.ip)) {
    return res.status(429).json({ error: "Too many requests - try again later" });
  }
  next();
});

// JSON body parser with limit
app.use(express.json({ limit: BODY_LIMIT }));

// Simple security headers (demo). Tighten for production.
app.use((req, res, next) => {
  res.setHeader("Content-Security-Policy", "default-src 'self'; img-src 'self' https://images.unsplash.com data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline';");
  res.setHeader("X-Frame-Options", "DENY");
  res.setHeader("X-Content-Type-Options", "nosniff");
  res.setHeader("Referrer-Policy", "no-referrer");
  next();
});

// Helpers
function createOrderId() {
  return "FF_" + Date.now() + "_" + crypto.randomBytes(4).toString("hex");
}

function computeHmacForOrder(orderId, amountCents) {
  return crypto.createHmac("sha256", MERCHANT_SECRET)
    .update(`${orderId}|${amountCents}`)
    .digest("hex");
}

// Serve single-page frontend
app.get("/", (req, res) => {
  res.type("html").send(`<!doctype html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Redeem Center</title>
<style>
