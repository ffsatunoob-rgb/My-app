.card{width:92%;max-width:420px;background:white;padding:28px;border-radius:18px;text-align:center;box-shadow:0 10px 35px #000}
h1{color:#111} .subtitle{color:#555}
.product{background:#f3f3f3;padding:18px;margin:15px 0;border-radius:12px}
button{width:100%;padding:14px;border:0;border-radius:9px;background:#ff6a00;color:white;font-size:17px;font-weight:bold;cursor:pointer}
button:hover{background:#e85d00}
#result{display:none;margin-top:20px}
.code{display:flex;margin-top:10px}
.code input{flex:1;padding:12px;border:1px solid #ccc;font-weight:bold;color:black}
.copy{width:55px;border-radius:0}
.coins{font-size:22px;font-weight:bold;margin:15px}
</style>
</head>
<body>
<div class="card">
  <h1>🔥 REDEEM CENTER</h1>
  <p class="subtitle">Buy a code and receive coins.</p>

  <div class="product">
    <h2>🪙 100 Coins</h2>
    <p>₹10</p>
    <button onclick="buy(10)">BUY NOW</button>
  </div>

  <div class="product">
    <h2>🪙 500 Coins</h2>
    <p>₹50</p>
    <button onclick="buy(50)">BUY NOW</button>
  </div>

  <div id="result">
    <h2>🎉 Payment Successful</h2>
    <div class="coins">+<span id="coins"></span> Coins</div>
    <div class="code">
      <input id="rewardCode" readonly>
      <button class="copy" onclick="copyCode()">📋</button>
    </div>
  </div>
</div>

<script>
async function buy(product) {
  try {
    const res = await fetch("/api/create-order", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ product })
    });
    const data = await res.json();
    if (!res.ok) {
      alert(data.error || "Failed to create order");
      return;
    }

    alert("Order created: " + data.orderId + "\\n\\nNow completing payment on the server (demo)...");
    const completeRes = await fetch("/api/complete-payment", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify({ orderId: data.orderId })
    });
    const completeData = await completeRes.json();
    if (!completeRes.ok) {
      alert(completeData.error || "Payment completion failed");
      return;
    }

    showReward(completeData.code, completeData.coins);
  } catch (err) {
    console.error(err);
    alert("Unexpected error");
  }
}

function showReward(code, coins) {
  document.getElementById("result").style.display = "block";
  document.getElementById("rewardCode").value = code;
  document.getElementById("coins").textContent = coins;
}

function copyCode(){
  const code = document.getElementById("rewardCode");
  navigator.clipboard.writeText(code.value);
  alert("📋 Code copied!");
}
