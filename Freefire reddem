});

// Create order endpoint
app.post("/api/create-order", (req, res) => {
  try {
    const product = Number(req.body && req.body.product);
    if (!PRODUCTS[product]) {
      return res.status(400).json({ error: "Invalid product" });
    }

    const orderId = createOrderId();
    const amountCents = PRODUCTS[product].price * 100;
    const coins = PRODUCTS[product].coins;

    const order = {
      orderId,
      product,
      amountCents,
      coins,
      status: "pending",
      createdAt: Date.now(),
      completedAt: null,
      code: null
    };

    ORDERS.set(orderId, order);

    return res.json({
      orderId,
      amount: amountCents,
      coins
    });
  } catch (err) {
    console.error("create-order error:", err && err.stack || err);
    res.status(500).json({ error: "Internal server error" });
  }
});

// Complete payment (demo verification)
app.post("/api/complete-payment", (req, res) => {
  try {
    const { orderId } = req.body || {};
    if (!orderId || typeof orderId !== "string") {
      return res.status(400).json({ error: "orderId required" });
    }

    const order = ORDERS.get(orderId);
    if (!order) {
      return res.status(404).json({ error: "Order not found" });
    }

    if (order.status === "completed") {
      return res.status(200).json({ message: "Order already completed", code: order.code, coins: order.coins });
    }

    // Demo-only: issue a code and mark completed
    let code = null;
    if (codes.length > 0) {
      code = codes.shift();
    } else {
      code = "FF-GEN-" + crypto.randomBytes(6).toString("hex").toUpperCase();
    }

    order.status = "completed";
    order.completedAt = Date.now();
    order.code = code;
    ORDERS.set(orderId, order);

    // For demo visibility we return a serverHmac (DO NOT return secrets in production)
    const serverHmac = computeHmacForOrder(order.orderId, order.amountCents);

    return res.json({ code, coins: order.coins, serverHmac });
  } catch (err) {
    console.error("complete-payment error:", err && err.stack || err);
    res.status(500).json({ error: "Internal server error" });
  }
});

// Get order status (demo)
app.get("/api/order/:orderId", (req, res) => {
  const orderId = req.params.orderId;
  if (!orderId) return res.status(400).json({ error: "orderId required" });
  const order = ORDERS.get(orderId);
  if (!order) return res.status(404).json({ error: "Order not found" });
  res.json(order);
});

// Basic error handler
app.use((err, req, res, next) => {
  console.error("Unhandled error:", err && err.stack || err);
  res.status(500).json({ error: "Internal server error" });
});

app.listen(PORT, () => {
  console.log(`Redeem Center running on http://localhost:${PORT}`);
});
